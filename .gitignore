# Ignore everything
*

# Allow root config and spec files
!.gitignore
!justfile
!spec.md
!pyproject.toml
!uv.lock

# Allow all directories to enable recursive whitelisting
!*/

# Allow specific extensions
!*.py
!*.R
!*.yaml
!*.yml
!*.qmd
!*.md
!*.toml
!*.lock

# Block noise directories explicitly
.quarto/
.ipynb_checkpoints/
__pycache__/
.venv/
# pixi environments
.pixi/*
!.pixi/config.toml

/.quarto/
**/*.quarto_ipynb
